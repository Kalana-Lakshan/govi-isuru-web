# Backend (govi-isuru-api) base URL, used by the Next.js server to forward /api/* and /uploads/*.
API_URL=http://localhost:5000
# Leave empty: the browser then calls /api on this site and Next.js forwards it.
NEXT_PUBLIC_API_URL=
# Live voice connects straight to the backend (Vercel does not forward WebSockets)
NEXT_PUBLIC_WS_URL=http://localhost:5000
